# ==============================================================================
# opsbox :: .gitignore
# 只忽略「生成物」与「本机噪音」，源码、夹具生成脚本（tests/fixtures/build.sh）、
# 配置模板（conf/opsbox.conf）都必须纳入版本控制。
# ==============================================================================

# ---------------------------------------------------------------- 测试中间产物 ----
# tests/run-tests.sh 的工作目录：两套假操作系统、生成的配置、报告与日志。
# 这些内容每次运行都会重建，属于纯粹的中间产物；需要保留时用
# `bash tests/run-tests.sh --keep` 本地查看即可，不要提交。
tests/.work/

# ---------------------------------------------------------------- 报告输出 ----
# 巡检报告：可能包含主机名、账户、端口等环境信息，不适合入库。
*.report.md
reports/

# ---------------------------------------------------------------- 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------------------------------------------------------------- 系统垃圾 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------- 临时文件 ----
*.tmp
*.temp
*.bak
*.orig
*.rej
*#
.#*
*.log.tmp

# 覆盖率 / 静态分析工具的中间产物
*.lcov
shellcheck.out
